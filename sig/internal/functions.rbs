module JMESPath
  class Functions
    class Metadata
      @variadic: bool
      def initialize: (String, Array[Array[Symbol]], bool, String?) -> void
    end

    class Definition < Data
      attr_reader signature: Signature
      attr_reader implementation: Symbol | ^(*value) -> value
      attr_reader description: String?
      def self.new: (Signature, Symbol | ^(*value) -> value, String?) -> instance
    end
    class Signature
      TYPES: Array[Symbol]
      @arguments: Array[Array[Symbol]]
      @variadic: bool
      attr_reader arguments: Array[Array[Symbol]]
      attr_reader variadic: bool
      module FailureOrigin
        @origin: Object?
        attr_reader origin: Object?
        def initialize: (?String?, ?origin: Object?, **untyped) -> void
      end
      class TypeMismatch < Errors::InvalidTypeError
        include FailureOrigin
      end
      class ArityMismatch < Errors::InvalidArityError
        include FailureOrigin
      end
      def initialize: (Array[Array[Symbol]], ?variadic: bool) -> void
      attr_reader arguments: Array[Array[Symbol]]
      def variadic?: () -> bool
      def validate!: (Array[value], String, ?origin: Object?, ?context: ValidationContext?) -> void
      private
      def reject_type!: (value, Integer, Array[Symbol], String, Object?, ValidationContext) -> bot
      def valid_definition?: (value) -> bool
      def valid_arity?: (Integer) -> bool
      def matches?: (value, Symbol) -> bool?
      def array_matches?: (value, Symbol) -> bool?
    end
    @definitions: Hash[String, Definition]
    def definition: (String) -> Definition?
    def call_with_context: (String, Array[value], source_range: Range[Integer], ?disable_visit_errors: bool?) -> value
    def with_builtin: (String, signature: Array[Array[Symbol]], handler: Symbol, ?variadic: bool) -> Functions
    private
    def invoke: (String, Array[value], disable_visit_errors: bool, ?source_range: Range[Integer]?) -> value
    def add: (String, Definition, override: bool) -> Functions
  end
end
