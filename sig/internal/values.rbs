module JMESPath
  module DataAccess
    module FieldLookup
      @field_name: String
      def field: (value, ?String) -> value?
    end
    extend FieldLookup
    class FieldReader
      include FieldLookup
      @field_name: String
      def initialize: (String) -> void
      def call: (value) -> value?
    end
    def self.field: (value, String) -> value?
    def self.array: (value) -> Array[value]?
    def self.object: (value) -> Hash[value, value]?
    def self.string: (value) -> String?
    def self.convert: (value, Class, Symbol) -> untyped
  end
  module Types
    def self.name: (value) -> Symbol
    def self.number?: (value) -> bool
    def self.falsey?: (value) -> bool
    def self.equal?: (value, value) -> bool
    def self.normalize: (value) -> value
    def self.collection_name: (value) -> Symbol
    def self.other_name: (value) -> Symbol
    def self.matching?: (value, value, Array[Array[value]]) -> bool
    def self.arrays_match?: (Array[value], value, Array[Array[value]]) -> bool
    def self.objects_match?: (Hash[value, value], value, Array[Array[value]]) -> bool
  end
  class ExpressionReference
    @block: ^(value) -> value
    def initialize: () { (value) -> value } -> void
    def call: (value) -> value
  end
end

module JMESPath
  class Normalizer
    @pending: Array[^() -> void]
    @active: Hash[Integer, bool]
    def initialize: () -> void
    def call: (value) -> value
    private
    def enqueue: (value) { (value) -> void } -> void
    def visit: (value) { (value) -> void } -> void
    def activate: (value) -> Integer
    def array: (Array[value]) { (value) -> void } -> void
    def object: (Hash[value, value]) { (value) -> void } -> void
  end
end
