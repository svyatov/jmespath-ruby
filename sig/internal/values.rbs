module JMESPath
  module DataAccess
    def self.field: (value, String) -> value?
    def self.array: (value) -> Array[value]?
    def self.object: (value) -> Hash[value, value]?
    def self.string: (value) -> String?
    def self.convert: (value, Class, Symbol) -> untyped
  end
  module Types
    def self.name: (value) -> Symbol
    def self.number?: (value) -> bool
    def self.falsey?: (value) -> bool
    def self.equal?: (value, value) -> bool
    def self.normalize: (value, ?Hash[Integer, bool]) -> value
    def self.collection_name: (value) -> Symbol
    def self.guarded: (value, Hash[Integer, bool]) { () -> value } -> value
  end
  class ExpressionReference
    @block: ^(value) -> value
    def initialize: () { (value) -> value } -> void
    def call: (value) -> value
  end
end
