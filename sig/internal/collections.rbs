module JMESPath
  class Functions
    DEFAULT: Functions
    module Coercions
      def self.reference: (value, ?origin: Object?) -> ExpressionReference
    end
    module Collections
      type sort_key = Integer | Float | String
      SIGNATURES: Hash[String, Array[Array[Symbol]]]
      def self.register: (Functions) -> Functions
      def self.sum: (value, ?origin: Object?) -> value
      def self.avg: (value, ?origin: Object?) -> Float?
      def self.min: (value, ?origin: Object?) -> value
      def self.max: (value, ?origin: Object?) -> value
      def self.sort: (value, ?origin: Object?) -> Array[value]
      def self.join: (value, value, ?origin: Object?) -> String
      def self.keys: (value, ?origin: Object?) -> Array[String]
      def self.values: (value, ?origin: Object?) -> Array[value]
      def self.merge: (*value, ?origin: Object?) -> Hash[value, value]
      def self.sort_key: (value, ?origin: Object?) -> sort_key
      def self.map: (value, value, ?origin: Object?) -> Array[value]
      def self.sort_by: (value, value, ?origin: Object?) -> Array[value]
      def self.min_by: (value, value, ?origin: Object?) -> value
      def self.max_by: (value, value, ?origin: Object?) -> value
      def self.keyed: (value, value, ?origin: Object?) -> Array[[sort_key, value]]
      def self.checked_type: (value, Symbol?, ?origin: Object?) -> Symbol
    end
  end
end
