module JMESPath
  class Functions
    DEFAULT: Functions
    module Coercions
      def reference: (value) -> ExpressionReference
      def self.reference: (value) -> ExpressionReference
    end
    module Collections : Coercions
      type sort_key = Integer | Float | String
      SIGNATURES: Hash[String, Array[Array[Symbol]]]
      SORTABLE_TYPES: Array[Symbol]
      def self.register: (Functions) -> Functions
      private
      def sum: (value) -> value
      def avg: (value) -> Float?
      def min: (value) -> value
      def max: (value) -> value
      def sort: (value) -> Array[value]
      def join: (value, value) -> String
      def keys: (value) -> Array[String]
      def values: (value) -> Array[value]
      def merge: (*value) -> Hash[value, value]
      def sort_key: (value) -> sort_key
      def map: (value, value) -> Array[value]
      def sort_by: (value, value) -> Array[value]
      def min_by: (value, value) -> value
      def max_by: (value, value) -> value
      def keyed: (value, value) -> Array[[sort_key, value]]
      def checked_type: (value, Symbol?) -> Symbol
    end
  end
end
