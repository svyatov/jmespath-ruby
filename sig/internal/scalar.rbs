module JMESPath
  class Functions
    module Scalar : Coercions
      SIGNATURES: Hash[String, Array[Array[Symbol]]]
      NUMBER: Regexp
      def self.register: (Functions) -> Functions
      private
      def abs: (value) -> (Integer | Float)
      def ceil: (value) -> Integer
      def floor: (value) -> Integer
      def contains?: (value, value) -> bool
      def ends_with?: (value, value) -> bool
      def starts_with?: (value, value) -> bool
      def length: (value) -> Integer
      def reverse: (value) -> (String | Array[value])
      def type: (value) -> String?
      def not_null: (*value) -> value
      def to_array: (value) -> Array[value]
      def to_string: (value) -> String
      def to_number: (value) -> value
    end
    module Coercions
      def number: (value) -> (Integer | Float)
      def string: (value) -> String
      def array: (value) -> Array[value]
      def object: (value) -> Hash[value, value]
      def self.number: (value) -> (Integer | Float)
      def self.string: (value) -> String
      def self.array: (value) -> Array[value]
      def self.object: (value) -> Hash[value, value]
      private
      def validation_origin: () -> Object?
    end
  end
end
