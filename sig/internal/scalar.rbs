module JMESPath
  class Functions
    module Scalar
      SIGNATURES: Hash[String, Array[Array[Symbol]]]
      NUMBER: Regexp
      def self.register: (Functions) -> Functions
      def self.abs: (value, ?origin: Object?) -> (Integer | Float)
      def self.ceil: (value, ?origin: Object?) -> Integer
      def self.floor: (value, ?origin: Object?) -> Integer
      def self.contains?: (value, value, ?origin: Object?) -> bool
      def self.ends_with?: (value, value, ?origin: Object?) -> bool
      def self.starts_with?: (value, value, ?origin: Object?) -> bool
      def self.length: (value, ?origin: Object?) -> Integer
      def self.reverse: (value, ?origin: Object?) -> (String | Array[value])
      def self.type: (value, ?origin: Object?) -> String?
      def self.not_null: (*value, ?origin: Object?) -> value
      def self.to_array: (value, ?origin: Object?) -> Array[value]
      def self.to_string: (value, ?origin: Object?) -> String
      def self.to_number: (value, ?origin: Object?) -> value
    end
    module Coercions
      def self.number: (value, ?origin: Object?) -> (Integer | Float)
      def self.string: (value, ?origin: Object?) -> String
      def self.array: (value, ?origin: Object?) -> Array[value]
      def self.object: (value, ?origin: Object?) -> Hash[value, value]
    end
  end
end
