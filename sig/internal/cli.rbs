module JMESPath
  module CLI
    class ArgumentParser < ::OptionParser
      def permute: (Array[String]) -> Array[String]
      private
      def complete: (Symbol, String, *untyped) -> [OptionParser::Switch, String]
    end

    USAGE: String
    HELP: String
    def self.literal_validation?: (Array[String]) -> bool
    def self.parse_arguments: (Array[String]) -> [String?, String?, String?, bool, bool, bool, bool]
    def self.argument_parser: (Hash[String, String]) -> ArgumentParser
    def self.check_sources: (Array[String], Hash[String, String]) -> void
    def self.check_modes: (Hash[String, String]) -> void
    def self.read_query: (String?, String?) -> String
    def self.read_document: (String?, _Reader) -> value
    def self.execute: (String, value, _Writer, bool, bool) -> Integer
    def self.execute_lines: (String, String?, _LineReader, _Writer, _Writer) -> Integer
    def self.process_lines: (Expression, String, _LineReader, _Writer, _Writer) -> Integer
    def self.validation: (Array[String], _Writer) -> Integer
    def self.information: (Array[String], _Writer) -> Integer
  end
end
