module JMESPath
  VERSION: String
  type value = Object?
  type json = nil | bool | Integer | Float | String | Array[json] | Hash[String, json]

  def self.search: (String, value, ?Hash[Symbol, value], **value) -> value
  def self.compile: (String, ?cache_expressions: bool, ?max_depth: Integer, ?functions: Functions, ?disable_visit_errors: bool) -> Expression

  module Errors
    class Error < StandardError
    end
    class RuntimeError < Error
    end
    class SyntaxError < Error
      attr_reader reason: String
      attr_reader expression: String
      attr_reader position: Integer
      def initialize: (String, ?expression: String, ?position: Integer) -> void
      def location_known?: () -> bool
      def line: () -> Integer
      def column: () -> Integer
    end
    class InvalidTypeError < RuntimeError
      include FunctionFailure
      attr_reader argument_position: Integer?
      attr_reader expected_types: Array[Symbol]?
      attr_reader actual_type: Symbol?
      attr_reader validation_stage: Symbol?
      def initialize: (?String?, ?argument_position: Integer?, ?expected_types: Array[Symbol]?, ?actual_type: Symbol?, ?validation_stage: Symbol?, ?function_name: String?, ?signature: Array[Array[Symbol]]?, ?variadic: bool?, ?source_range: Range[Integer]?) -> void
    end
    class InvalidValueError < RuntimeError
    end
    class InvalidArityError < RuntimeError
      include FunctionFailure
      attr_reader expected_arity: Integer?
      attr_reader actual_arity: Integer?
      def initialize: (?String?, ?expected_arity: Integer?, ?actual_arity: Integer?, ?function_name: String?, ?signature: Array[Array[Symbol]]?, ?variadic: bool?, ?source_range: Range[Integer]?) -> void
    end
    class UnknownFunctionError < RuntimeError
    end

    module FunctionFailure
      @variadic: bool?
      attr_reader function_name: String?
      attr_reader signature: Array[Array[Symbol]]?
      attr_reader source_range: Range[Integer]?
      def initialize: (?String?, ?function_name: String?, ?signature: Array[Array[Symbol]]?, ?variadic: bool?, ?source_range: Range[Integer]?) -> void
      def variadic?: () -> bool?
    end
  end

  module Diagnostic
    def self.format: (Errors::SyntaxError) -> String
  end

  class Expression
    attr_reader source: String
    def search: (value, ?Hash[Symbol, value], **value) -> value
    alias call search
  end

  class Functions
    def initialize: () -> void
    def self.default: () -> Functions
    def with: (String, signature: Array[Array[Symbol]], ?variadic: bool, ?override: bool) ?{ (*value) -> value } -> Functions
    def call: (String, Array[value], ?disable_visit_errors: bool) -> value
  end

  # Input stream protocol used by CLI.run.
  interface _Reader
    def read: () -> String?
  end
  # Output stream protocol used by CLI.run.
  interface _Writer
    def puts: (String) -> void
  end
  module CLI
    def self.run: (Array[String], ?stdin: _Reader, ?stdout: _Writer, ?stderr: _Writer) -> Integer
  end
end
